# 复制为 .env 后按需修改（.env 不提交）
DATABASE_URL=postgres://blog:blog@localhost:5432/blog
# 前端的源：决定 Passkey 的 RP ID、CSRF 的 Origin 校验、cookie 是否加 Secure
WEB_ORIGIN=http://localhost:3000
# 一次性设置口令：允许不登录注册 Passkey（首次设置 / 恢复）。用完删掉。生成：openssl rand -base64 32
ADMIN_SETUP_TOKEN=
# 与前端共享：写入文章后通知前端 /hooks/revalidate 失效缓存。不设置则不通知（前端每小时自动刷新）
REVALIDATE_SECRET=
# Redis（限流、阅读计数）。线上用 Upstash：rediss://default:…@…upstash.io:6379。不设置则不限流、不计数
REDIS_URL=redis://localhost:6379
# 每日把阅读数写入 Postgres 的定时任务密钥（Vercel Cron 自动携带）。生成：openssl rand -base64 32
CRON_SECRET=
PORT=8787
