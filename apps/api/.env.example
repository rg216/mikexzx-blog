# 复制为 .env 后按需修改（.env 不提交）
DATABASE_URL=postgres://blog:blog@localhost:5432/blog
# 前端的源：决定 Passkey 的 RP ID、CSRF 的 Origin 校验、cookie 是否加 Secure
WEB_ORIGIN=http://localhost:3000
# 一次性设置口令：允许不登录注册 Passkey（首次设置 / 恢复）。用完删掉。生成：openssl rand -base64 32
ADMIN_SETUP_TOKEN=
# 与前端共享：写入文章后通知前端 /hooks/revalidate 失效缓存。不设置则不通知（前端每小时自动刷新）
REVALIDATE_SECRET=
# Redis（限流、阅读计数）。线上用 Upstash：rediss://default:…@…upstash.io:6379。不设置则不限流、不计数
REDIS_URL=redis://localhost:6379
# 每日把阅读数写入 Postgres 的定时任务密钥（Vercel Cron 自动携带）。生成：openssl rand -base64 32
CRON_SECRET=
PORT=8787

# 图片存储（S3 协议）。本地是 docker compose 里的 RustFS；线上是 Cloudflare R2：
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
#   S3_PUBLIC_URL=存储桶的公开地址（r2.dev 或绑定的自定义域名）
# 五项（REGION 除外）要么全设，要么全不设（不设则后台不能上传图片）
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=blog-images
S3_ACCESS_KEY_ID=blog-dev-access-key
S3_SECRET_ACCESS_KEY=blog-dev-secret-key
S3_PUBLIC_URL=http://localhost:9000/blog-images

# 评论者的 GitHub 登录：GitHub App 的 Client ID / Client secret（回调地址 <WEB_ORIGIN>/api/auth/github/callback）。
# 两项一起设置；不设置则评论区只读
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
